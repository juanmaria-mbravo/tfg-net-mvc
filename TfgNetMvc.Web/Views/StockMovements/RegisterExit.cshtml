@model TfgNetMvc.Web.ViewModels.StockMovements.RegisterStockExitViewModel

@{
    ViewData["Title"] = "Register Stock Exit";
}

<h1>Register Stock Exit</h1>

<form asp-action="RegisterExit" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="ItemId" class="form-label"></label>
        <select asp-for="ItemId" asp-items="Model.Items" class="form-control">
            <option value="">-- Select item --</option>
        </select>
        <span asp-validation-for="ItemId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" type="number" min="1" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="WarehouseLocationId" class="form-label"></label>
        <select asp-for="WarehouseLocationId" asp-items="Model.WarehouseLocations" class="form-control">
            <option value="">-- No location --</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Reason" class="form-label"></label>
        <input asp-for="Reason" class="form-control" />
        <span asp-validation-for="Reason" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-warning">Register Exit</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
