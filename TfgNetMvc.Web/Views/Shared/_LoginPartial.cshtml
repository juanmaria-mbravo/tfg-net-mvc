@using Microsoft.AspNetCore.Identity
@inject SignInManager<TfgNetMvc.Infrastructure.Identity.ApplicationUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
        <button type="submit" class="btn btn-link nav-link text-dark px-0">Logout</button>
    </form>
}
else
{
    <a class="nav-link text-dark px-0" asp-area="Identity" asp-page="/Account/Login">Login</a>
}
