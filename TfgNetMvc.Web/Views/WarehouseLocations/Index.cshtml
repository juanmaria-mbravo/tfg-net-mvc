@model List<TfgNetMvc.Web.ViewModels.WarehouseLocations.WarehouseLocationListViewModel>

@{
    ViewData["Title"] = "Warehouse Locations";
}

<h1>Warehouse Locations</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create new</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var location in Model)
{
        <tr>
            <td>@location.Name</td>
            <td>@location.Description</td>
            <td>
                <a asp-action="Details" asp-route-id="@location.Id">Details</a> |
                <a asp-action="Edit" asp-route-id="@location.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@location.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
