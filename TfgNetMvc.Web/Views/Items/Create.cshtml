@model TfgNetMvc.Web.ViewModels.Items.CreateItemViewModel

@{
    ViewData["Title"] = "Create Item";
}

<h1>Create Item</h1>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Stock" class="form-label"></label>
        <input asp-for="Stock" type="number" class="form-control" />
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-control">
            <option value="">-- No category --</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="WarehouseLocationId" class="form-label"></label>
        <select asp-for="WarehouseLocationId" asp-items="Model.WarehouseLocations" class="form-control">
            <option value="">-- No location --</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>